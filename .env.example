# Application
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FE_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
REQUEST_ID_HEADER=x-request-id

# Database (MongoDB Atlas)
# Never commit real credentials. Provide via CI/secrets manager in deployed environments.
DATABASE_URL=mongodb://localhost:27017/career-intelligence-os
MONGODB_URI=mongodb://localhost:27017/career-intelligence-os

# Cache / Queue (Redis)
REDIS_URL=redis://localhost:6379

# Auth / Sessions
NEXTAUTH_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production
APP_SECRET=change-me-in-production

# JWT
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OAuth (Gmail / Microsoft Graph) — populate in provider consoles
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/v1/auth/microsoft/callback

# Encryption (envelope encryption for refresh tokens / credentials)
ENCRYPTION_MASTER_KEY=change-me-32-bytes-secret-key!!

# S3 (private document storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_DOCUMENTS=career-intelligence-os-documents

# AI provider adapters (plug real provider credentials when available)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=
AI_MODEL_FALLBACK=

# Observability
SENTRY_DSN=
OTEL_SERVICE_NAME=career-intelligence-os

# Feature flags (off by default)
FEATURE_GMAIL_WATCH=false
FEATURE_MICROSOFT_SYNC=false
FEATURE_OUTBOUND_EMAIL=false
