{
  "name": "@career-intelligence/be",
  "private": true,
  "version": "0.1.0",
  "description": "Career Intelligence OS backend (NestJS) — owns API and AUTH boundaries.",
  "main": "dist/main",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
