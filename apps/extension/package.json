{
  "name": "@career-intelligence/extension",
  "private": true,
  "version": "0.1.0",
  "description": "Career Intelligence OS Chrome Manifest V3 extension.",
  "scripts": {
    "build": "tsc --noEmit && echo \"Extension typecheck passed\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
